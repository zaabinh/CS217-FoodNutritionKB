        {"name": "policy_status", "type": "string", "required": true, "enum": ["complete", "unknown"]}
      ],
      "example_id": "diet_vegan",
      "related_rule_ids": ["R03", "R05", "R14"],
      "_meta": {
        "source_ids": ["source_th1", "source_th2", "source_design"]
      }
