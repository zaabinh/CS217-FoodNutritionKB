    {
      "id": "nutrient",
      "display_name": "Nutrient",
      "description": "Đại lượng dinh dưỡng; năng lượng được đưa chung vào danh mục theo yêu cầu.",
      "syntax": "nutrient(id)",
      "notation": "nutrient(nutrient_protein)",
      "attributes": [
        {"name": "id", "type": "string", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "unit", "type": "string", "required": true, "enum": ["kcal", "g", "mg"]},
        {"name": "usda_nutrient_id", "type": "integer", "required": true, "minimum": 1}
      ],
      "example_id": "nutrient_protein",
      "related_rule_ids": ["R06", "R07", "R11", "R13"],
      "_meta": {
        "source_ids": ["source_th1", "source_th2", "source_design"]
      }
    },
    {
      "id": "nutrient_content",
      "display_name": "NutrientContent",
      "description": "Bản ghi hàm lượng của một food và một nutrient.",
      "syntax": "nutrient_content(id)",
      "notation": "nutrient_content(nc_rice_cooked_protein)",
      "attributes": [
        {"name": "id", "type": "string", "required": true},
        {"name": "value", "type": ["number", "null"], "required": true, "minimum": 0},
        {"name": "basis_g", "type": "number", "required": true, "const": 100, "unit": "g"},
        {"name": "status", "type": "string", "required": true, "enum": ["known", "unknown"]},
        {"name": "source_id", "type": "string", "required": true},
        {"name": "source_record_id", "type": ["string", "null"], "required": true}
      ],
      "example_id": "nc_rice_cooked_protein",
      "related_rule_ids": ["R05", "R06", "R07"],
      "_meta": {
        "source_ids": ["source_th1", "source_th2", "source_design"]
      }
    },
