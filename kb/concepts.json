    {
      "id": "user_profile",
      "display_name": "UserProfile",
      "description": "Hồ sơ đầu vào giả lập; các khai báo không phải tri thức chuyên môn.",
      "syntax": "user_profile(id)",
      "notation": "user_profile(user_minh)",
      "attributes": [
        {"name": "id", "type": "string", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "context", "type": "object", "required": true, "properties": {"age": {"type": "integer", "minimum": 18}, "sex": {"type": "string", "enum": ["female", "male", "unspecified"]}, "activity": {"type": "string", "enum": ["low", "moderate", "high"]}, "weight_kg": {"type": "number", "exclusive_minimum": 0, "unit": "kg"}, "height_cm": {"type": "number", "exclusive_minimum": 0, "unit": "cm"}}, "required_fields": ["age", "sex", "activity"]},
        {"name": "nutrition_goal", "type": "string", "required": true, "enum": ["prefer_protein", "prefer_fiber", "prefer_calcium", "none", "lose_weight"]},
        {"name": "allergy_status", "type": "string", "required": true, "enum": ["complete", "unknown"]},
        {"name": "avoid_status", "type": "string", "required": true, "enum": ["complete", "unknown"]}
      ],
      "example_id": "user_minh",
      "related_rule_ids": ["R01", "R03", "R04", "R05", "R07", "R08", "R09", "R10", "R11", "R12", "R13", "R14"],
      "_meta": {
        "source_ids": ["source_th1", "source_th2", "source_design"]
      }
