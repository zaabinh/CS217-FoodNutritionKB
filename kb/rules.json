{
  "representation": "declarative_specification_not_executable_python",
  "rules": [
    {
      "id": "R01",
      "name": "Loại food chứa tác nhân người dùng dị ứng",
      "phase": "hard_constraints",
      "priority": 100,
      "kind": "hard",
      "if_all": ["allergic_to(u,a)", "contains_allergen(f,a)"],
      "then": {
        "action": "set_status",
        "target": "food f for user u",
        "value": "rejected",
        "reason": "allergen_match",
        "trace": ["u", "a", "f"]
      },
      "concept_ids": ["user_profile", "food", "allergen"],
      "relation_names": ["allergic_to", "contains_allergen"],
      "source_ids": ["source_fda", "source_design"],
      "exec": {
        "when": [
          {"rel": "allergic_to", "args": ["?u", "?a"]},
          {"rel": "contains_allergen", "args": ["?f", "?a"], "truth": "true"}
        ],
        "then": {"action": "set_status", "target": "?f", "value": "rejected", "reason": "allergen_match"}
      }
    },
    {
      "id": "R02",
      "name": "Lan truyền trạng thái qua nguyên liệu, món, bữa và thực đơn",
      "phase": "propagation",
      "priority": 95,
      "kind": "hard",
      "if_all": ["children(x) xác định bởi uses_ingredient / contains_dish / contains_meal", "Có ít nhất một child rejected hoặc requires_review"],
      "then": {
        "action": "aggregate_status",
        "target": "parent x for user u",
        "order": ["rejected", "requires_review"],
        "trace": "Giữ child ID, đường quan hệ và rule gây trạng thái."
      },
      "concept_ids": ["food", "dish", "meal", "menu"],
      "relation_names": ["uses_ingredient", "contains_dish", "contains_meal"],
      "source_ids": ["source_th2", "source_design"],
      "exec": {
        "then": {
          "action": "propagate_status",
          "via": ["uses_ingredient", "contains_dish", "contains_meal"],
          "order": ["rejected", "requires_review"]
        }
      }
    },
    {
      "id": "R03",
      "name": "Loại food không phù hợp chế độ ăn",
      "phase": "hard_constraints",
      "priority": 100,
      "kind": "hard",
      "if_all": ["follows_diet(u,d)", "Not(compatible_with_diet(f,d)) đã biết tường minh hoặc theo danh mục complete"],
      "then": {
        "action": "set_status",
        "target": "food f for user u",
        "value": "rejected",
        "reason": "diet_mismatch",
        "trace": ["u", "d", "f"]
      },
      "concept_ids": ["user_profile", "diet_pattern", "food"],
      "relation_names": ["follows_diet", "compatible_with_diet"],
      "source_ids": ["source_vegetarian", "source_vegan", "source_design"],
      "exec": {
        "when": [
          {"rel": "follows_diet", "args": ["?u", "?d"]},
          {"rel": "compatible_with_diet", "args": ["?f", "?d"], "truth": "false"}
        ],
        "then": {"action": "set_status", "target": "?f", "value": "rejected", "reason": "diet_mismatch"}
      }
    },
    {
      "id": "R04",
      "name": "Loại food người dùng cần tránh",
      "phase": "hard_constraints",
      "priority": 100,
      "kind": "hard",
      "if_all": ["avoids_food(u,f)"],
      "then": {
        "action": "set_status",
        "target": "food f for user u",
        "value": "rejected",
        "reason": "explicit_avoid",
        "trace": ["u", "f"]
      },
      "concept_ids": ["user_profile", "food"],
      "relation_names": ["avoids_food"],
      "source_ids": ["source_th2", "source_design"],
      "exec": {
        "when": [{"rel": "avoids_food", "args": ["?u", "?f"]}],
        "then": {
          "action": "set_status",
          "target": "?f",
          "value": "rejected",
          "reason": "explicit_avoid",
          "note_if": {
            "when": [{"rel": "prefers_food", "args": ["?u", "?f"], "where": {"preference": "like"}}],
            "note": "avoid_overrides_like"
          }
        }
      }
    },
    {
      "id": "R05",
      "name": "Chặn kết luận khi thiếu dữ liệu cần thiết",
      "phase": "hard_constraints",
      "priority": 90,
      "kind": "hard",
      "then": {
        "action": "set_status_unless_rejected",
        "target": "affected food/dish/meal/menu for user u",
        "value": "requires_review",
        "reason": "missing_required_data",
        "trace": "Liệt kê trường hoặc tham chiếu thiếu."
      },
      "concept_ids": ["user_profile", "food", "dish", "nutrient_content", "diet_pattern"],
      "relation_names": ["follows_diet", "compatible_with_diet", "has_nutrient_content", "measures_nutrient", "uses_ingredient"],
      "source_ids": ["source_th2", "source_design"],
      "if_any": ["Thiếu khai báo dị ứng/tránh của user hoặc thiếu hồ sơ chế độ", "HOẶC food allergen_status=unknown, kết quả chế độ đang chọn unknown, recipe_status=unknown", "HOẶC hàm lượng cần cho mục tiêu hoặc định lượng thành phần chưa biết"],
      "exec": {
        "when_any": [
          {
            "detail": "user_allergy_status_unknown",
            "target": "?f",
            "when": [{"attr": "?u.allergy_status", "op": "eq", "value": "unknown"}, {"each": "food", "var": "?f"}]
          },
          {
            "detail": "user_avoid_status_unknown",
            "target": "?f",
            "when": [{"attr": "?u.avoid_status", "op": "eq", "value": "unknown"}, {"each": "food", "var": "?f"}]
          },
          {
            "detail": "diet_policy_unknown",
            "target": "?f",
            "when": [
              {"rel": "follows_diet", "args": ["?u", "?d"]},
              {"attr": "?d.policy_status", "op": "eq", "value": "unknown"},
              {"each": "food", "var": "?f"}
            ]
          },
          {
            "detail": "food_allergen_unknown",
            "target": "?f",
            "when": [
              {"rel": "allergic_to", "args": ["?u", "?a"]},
              {"rel": "contains_allergen", "args": ["?f", "?a"], "truth": "unknown"}
            ]
          },
          {
            "detail": "food_diet_unknown",
            "target": "?f",
            "when": [
              {"rel": "follows_diet", "args": ["?u", "?d"]},
              {"rel": "compatible_with_diet", "args": ["?f", "?d"], "truth": "unknown"}
            ]
          },
          {
            "detail": "recipe_unknown",
            "target": "?x",
            "when": [{"each": "dish", "var": "?x"}, {"attr": "?x.recipe_status", "op": "eq", "value": "unknown"}]
          },
          {
            "detail": "goal_nutrient_unknown",
            "target": "?f",
            "when": [{"goal_nutrient": ["?u", "?n"]}, {"nutrient_value": ["?f", "?n"], "truth": "unknown"}]
          }
        ],
        "then": {
          "action": "set_status_unless_rejected",
          "value": "requires_review",
          "reason": "missing_required_data"
        }
      }
    },
    {
      "id": "R06",
      "name": "Tổng hợp hàm lượng theo định lượng",
      "phase": "aggregation",
      "priority": 70,
      "kind": "calculation",
      "if_all": ["Mỗi giá trị cần dùng có status=known, basis_g=100, cùng đúng trạng thái Food", "Định lượng và servings hợp lệ"],
      "then": {
        "action": "calculate_nutrients",
        "formula": "Dish.recipe_total[n] = Σ amount_g(food) × value_per_100g(food,n) / 100; Dish.per_serving = recipe_total / dish.servings; Meal = Σ meal_servings × Dish.per_serving; Menu = Σ Meal.",
        "on_missing": "value=null và missing_inputs; không thay bằng 0"
      },
      "concept_ids": ["food", "nutrient", "nutrient_content", "dish", "meal", "menu"],
      "relation_names": ["has_nutrient_content", "measures_nutrient", "uses_ingredient", "contains_dish", "contains_meal"],
      "source_ids": ["source_usda_dictionary", "source_design"],
      "exec": {
        "then": {
          "action": "aggregate_nutrients",
          "steps": [
            {
              "concept": "dish",
              "via": "uses_ingredient",
              "weight_attr": "amount_g",
              "per_basis_g": true,
              "divide_by_attr": "servings",
              "basis": "per_serving"
            },
            {"concept": "meal", "via": "contains_dish", "weight_attr": "servings", "basis": "whole_meal"},
            {"concept": "menu", "via": "contains_meal", "basis": "one_day"}
          ]
        }
      }
    },
    {
      "id": "R07",
      "name": "Ưu tiên theo chất dinh dưỡng mục tiêu",
      "phase": "ranking",
      "priority": 20,
      "kind": "soft",
      "if_all": ["u.nutrition_goal ánh xạ tới chất dinh dưỡng n trong exec.then.goals", "R09 cho phép hai ứng viên x, y cùng concept và cùng cơ sở so sánh tương ứng", "N(x,n) và N(y,n) đều known; N(x,n)>N(y,n)"],
      "then": {"action": "prefer_candidate", "preferred": "x", "over": "y", "reason": "higher_selected_nutrient_at_same_basis"},
      "concept_ids": ["user_profile", "food", "dish", "meal", "menu", "nutrient", "nutrient_content"],
      "relation_names": ["has_nutrient_content", "measures_nutrient", "uses_ingredient", "contains_dish", "contains_meal"],
      "source_ids": ["source_th1", "source_design"],
      "exec": {
        "then": {
          "action": "goal_metric",
          "goals": {
            "prefer_protein": {"nutrient": "nutrient_protein", "direction": "desc"},
            "prefer_fiber": {"nutrient": "nutrient_fiber", "direction": "desc"},
            "prefer_calcium": {"nutrient": "nutrient_calcium", "direction": "desc"}
          }
        }
      }
    },
    {
      "id": "R08",
      "name": "Xếp hạng theo sở thích sau mục tiêu",
      "phase": "ranking",
      "priority": 10,
      "kind": "soft",
      "if_all": ["Ứng viên đã eligible theo R09", "Xét các food xuất hiện trong ứng viên; không đếm một food hai lần"],
      "then": {
        "action": "calculate_preference_score",
        "formula": "Σ (+1 nếu like; -1 nếu dislike; 0 nếu chưa khai báo)",
        "use": "Chỉ dùng khi goal=none hoặc giá trị mục tiêu bằng nhau; đi xuống các thành phần, đếm mỗi Food một lần. Không khôi phục rejected/requires_review."
      },
      "concept_ids": ["user_profile", "food", "dish", "meal", "menu"],
      "relation_names": ["prefers_food", "uses_ingredient", "contains_dish", "contains_meal"],
      "source_ids": ["source_th2", "source_design"],
      "exec": {
        "then": {
          "action": "preference_score",
          "relation": "prefers_food",
          "attribute": "preference",
          "weights": {"like": 1, "dislike": -1},
          "default": 0,
          "count_each_food_once": true
        }
      }
    },
    {
      "id": "R09",
      "name": "Xác nhận eligible trong phạm vi mô hình",
      "phase": "eligibility",
      "priority": 80,
      "kind": "hard",
      "if_all": ["Validation cấu trúc không có lỗi", "Các kiểm tra bắt buộc cho user và mọi thành phần đều đủ dữ liệu", "Pha hard_constraints và propagation đã đạt điểm cố định; không có rejected/requires_review"],
      "then": {
        "action": "set_status",
        "target": "candidate for user u",
        "value": "eligible_in_model",
        "reason": "all_required_checks_passed",
        "final_order": "Metric mục tiêu giảm dần, rồi preference_score giảm dần, rồi độ phủ nhóm thực phẩm (R14, chỉ Menu) giảm dần, rồi ID tăng dần."
      },
      "concept_ids": ["user_profile", "food", "dish", "meal", "menu"],
      "relation_names": ["uses_ingredient", "contains_dish", "contains_meal", "follows_diet", "compatible_with_diet"],
      "source_ids": ["source_th2", "source_design"],
      "exec": {
        "then": {
          "action": "set_eligible",
          "value": "eligible_in_model",
          "reason": "all_required_checks_passed",
          "concepts": ["food", "dish", "meal", "menu"],
          "final_tie_break": "id_asc"
        }
      }
    },
    {
      "id": "R10",
      "name": "Ước tính nhu cầu năng lượng theo tuổi, giới và mức vận động",
      "phase": "aggregation",
      "priority": 65,
      "kind": "calculation",
      "if_all": ["u.context có age, sex thuộc {female, male} và activity", "Có hàng của bảng DGA 2020–2025 Table A2-2 ứng với giới và tuổi của u"],
      "then": {
        "action": "lookup_energy_requirement",
        "target": "user u",
        "output": "energy_requirement (kcal/ngày)",
        "mapping": "activity low = Sedentary, moderate = Moderately Active, high = Active (ánh xạ thiết kế của nhóm)",
        "on_missing": "null; không đoán khi sex = unspecified"
      },
      "concept_ids": ["user_profile"],
      "relation_names": [],
      "source_ids": ["source_dga_energy", "source_design"],
      "exec": {
        "then": {
          "action": "lookup_table",
          "output": "energy_requirement",
          "unit": "kcal/ngày",
          "inputs": {"sex": "?u.context.sex", "age": "?u.context.age", "activity": "?u.context.activity"},
          "columns": ["sex", "age_min", "age_max", "sedentary", "moderately_active", "active"],
          "match": [
            {"input": "sex", "column": "sex"},
            {"input": "age", "min_column": "age_min", "max_column": "age_max"}
          ],
          "select": {
            "input": "activity",
            "map": {"low": "sedentary", "moderate": "moderately_active", "high": "active"}
          },
          "rows": [
            ["male", 18, 18, 2400, 2800, 3200],
            ["male", 19, 20, 2600, 2800, 3000],
            ["male", 21, 25, 2400, 2800, 3000],
            ["male", 26, 30, 2400, 2600, 3000],
            ["male", 31, 35, 2400, 2600, 3000],
            ["male", 36, 40, 2400, 2600, 2800],
            ["male", 41, 45, 2200, 2600, 2800],
            ["male", 46, 50, 2200, 2400, 2800],
            ["male", 51, 55, 2200, 2400, 2800],
            ["male", 56, 60, 2200, 2400, 2600],
            ["male", 61, 65, 2000, 2400, 2600],
            ["male", 66, 70, 2000, 2200, 2600],
            ["male", 71, 75, 2000, 2200, 2600],
            ["male", 76, null, 2000, 2200, 2400],
            ["female", 18, 18, 1800, 2000, 2400],
            ["female", 19, 20, 2000, 2200, 2400],
            ["female", 21, 25, 2000, 2200, 2400],
            ["female", 26, 30, 1800, 2000, 2400],
            ["female", 31, 35, 1800, 2000, 2200],
            ["female", 36, 40, 1800, 2000, 2200],
            ["female", 41, 45, 1800, 2000, 2200],
            ["female", 46, 50, 1800, 2000, 2200],
            ["female", 51, 55, 1600, 1800, 2200],
            ["female", 56, 60, 1600, 1800, 2200],
            ["female", 61, 65, 1600, 1800, 2000],
            ["female", 66, 70, 1600, 1800, 2000],
            ["female", 71, 75, 1600, 1800, 2000],
            ["female", 76, null, 1600, 1800, 2000]
          ]
        }
      }
    },
    {
      "id": "R11",
      "name": "Mục tiêu năng lượng mỗi ngày và tỷ lệ đáp ứng của thực đơn",
      "phase": "aggregation",
      "priority": 60,
      "kind": "calculation",
      "if_all": ["R10 đã cho energy_requirement(u)", "Nếu u.nutrition_goal = lose_weight thì đã biết giới tính để chọn mức sàn"],
      "then": {
        "action": "calculate_energy_target",
        "target": "user u và từng menu",
        "formula": "lose_weight: energy_target = max(energy_requirement − 500, 1200 nếu nữ / 1500 nếu nam); mục tiêu khác: energy_target = energy_requirement. Menu: energy_ratio = năng lượng Menu (R06) / energy_target.",
        "use": "Chỉ hiển thị và dùng cho R13; không đổi trạng thái ứng viên. Không thay thế chỉ định của chuyên gia."
      },
      "concept_ids": ["user_profile", "menu", "nutrient"],
      "relation_names": ["has_nutrient_content", "measures_nutrient", "uses_ingredient", "contains_dish", "contains_meal"],
      "source_ids": ["source_aha_2013", "source_design"],
      "exec": {
        "then": {
          "action": "energy_target",
          "requirement": "energy_requirement",
          "output": "energy_target",
          "unit": "kcal/ngày",
          "adjustments": {"lose_weight": {"deficit_kcal": 500, "floor_kcal_by_sex": {"female": 1200, "male": 1500}}},
          "ratio": {"concept": "menu", "nutrient": "nutrient_energy", "output": "energy_ratio"}
        }
      }
    },
    {
      "id": "R12",
      "name": "Chặn mục tiêu giảm cân khi chưa xác nhận thừa cân",
      "phase": "hard_constraints",
      "priority": 90,
      "kind": "hard",
      "if_all": ["u.nutrition_goal = lose_weight"],
      "if_any": ["Thiếu cân nặng hoặc chiều cao nên chưa tính được BMI", "HOẶC BMI = cân nặng (kg) / chiều cao² (m²) < 25, dưới ngưỡng thừa cân của WHO", "HOẶC giới tính chưa xác định nên không ước tính được năng lượng"],
      "then": {
        "action": "set_status_unless_rejected",
        "target": "mọi food của u; R02 lan truyền lên dish/meal/menu",
        "value": "requires_review",
        "reason": "weight_loss_not_supported",
        "trace": "Ghi BMI đã tính hoặc thuộc tính còn thiếu; khuyến nghị hỏi chuyên gia."
      },
      "concept_ids": ["user_profile", "food"],
      "relation_names": [],
      "source_ids": ["source_who_bmi", "source_aha_2013", "source_design"],
      "exec": {
        "when": [{"attr": "?u.nutrition_goal", "op": "eq", "value": "lose_weight"}],
        "when_any": [
          {
            "detail": "bmi_unknown",
            "target": "?f",
            "when": [
              {"expr": "?u.context.weight_kg / (?u.context.height_cm / 100) ** 2", "op": "missing"},
              {"each": "food", "var": "?f"}
            ]
          },
          {
            "detail": "bmi_below_threshold",
            "target": "?f",
            "when": [
              {"expr": "?u.context.weight_kg / (?u.context.height_cm / 100) ** 2", "op": "lt", "value": 25},
              {"each": "food", "var": "?f"}
            ]
          },
          {
            "detail": "sex_unspecified",
            "target": "?f",
            "when": [
              {"attr": "?u.context.sex", "op": "not_in", "value": ["female", "male"]},
              {"each": "food", "var": "?f"}
            ]
          }
        ],
        "then": {
          "action": "set_status_unless_rejected",
          "value": "requires_review",
          "reason": "weight_loss_not_supported"
        }
      }
    },
    {
      "id": "R13",
      "name": "Ưu tiên năng lượng phù hợp mục tiêu giảm cân",
      "phase": "ranking",
      "priority": 20,
      "kind": "soft",
      "if_all": ["u.nutrition_goal = lose_weight", "R09 cho phép hai ứng viên cùng concept và cùng cơ sở so sánh tương ứng", "Năng lượng của các ứng viên đều known"],
      "then": {
        "action": "prefer_candidate",
        "preferred": "Menu: |năng lượng − energy_target (R11)| nhỏ hơn; Food/Dish/Meal: năng lượng thấp hơn ở cùng cơ sở",
        "reason": "energy_closer_to_target / lower_energy_at_same_basis"
      },
      "concept_ids": ["user_profile", "food", "dish", "meal", "menu", "nutrient", "nutrient_content"],
      "relation_names": ["has_nutrient_content", "measures_nutrient", "uses_ingredient", "contains_dish", "contains_meal"],
      "source_ids": ["source_aha_2013", "source_design"],
      "exec": {
        "then": {
          "action": "goal_metric",
          "goals": {
            "lose_weight": {
              "nutrient": "nutrient_energy",
              "direction": "asc",
              "by_concept": {"menu": {"mode": "closest_to", "target": "energy_target"}}
            }
          }
        }
      }
    },
    {
      "id": "R14",
      "name": "Ưu tiên thực đơn cân bằng nhóm thực phẩm",
      "phase": "ranking",
      "priority": 5,
      "kind": "soft",
      "if_all": ["Hai Menu đều eligible theo R09", "Đồng hạng theo mục tiêu (R07/R13) và sở thích (R08)"],
      "then": {
        "action": "prefer_candidate",
        "preferred": "Menu phủ nhiều nhóm hơn trong 6 nhóm của bài (tương ứng 6 thành phần cốt lõi của DGA)",
        "exclude": "Bỏ group_dairy khỏi tập nhóm cần phủ khi u theo diet_vegan hoặc dị ứng allergen_milk",
        "trace": "Liệt kê nhóm còn thiếu."
      },
      "concept_ids": ["user_profile", "menu", "food", "food_group", "diet_pattern", "allergen"],
      "relation_names": ["belongs_to_group", "uses_ingredient", "contains_dish", "contains_meal", "follows_diet", "allergic_to"],
      "source_ids": ["source_dga_food_groups", "source_design"],
      "exec": {
        "then": {
          "action": "group_coverage",
          "applies_to": ["menu"],
          "membership_relation": "belongs_to_group",
          "groups": [
            "group_starch",
            "group_protein",
            "group_vegetables",
            "group_fruits",
            "group_dairy",
            "group_fats_oils"
          ],
          "exclude_groups": [
            {
              "group": "group_dairy",
              "when_any": [
                [{"rel": "follows_diet", "args": ["?u", "diet_vegan"]}],
